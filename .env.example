# Copy this file to .env and fill in the values.

# ---------------------------------------------------------------------------
# App
# ---------------------------------------------------------------------------
PORT=3000

# Public HTTPS URL that reaches this server (e.g. your ngrok URL, no trailing slash).
# Used for OAuth redirect URIs AND for TikTok, which downloads the photo from this URL.
#   TikTok redirect URI : {PUBLIC_BASE_URL}/auth/tiktok/callback
#   Facebook redirect URI: {PUBLIC_BASE_URL}/auth/facebook/callback
PUBLIC_BASE_URL=https://your-subdomain.ngrok-free.app

# 32-byte hex key used to encrypt tokens at rest. Generate with: npm run gen-key
TOKEN_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Facebook (Meta for Developers -> your app)
# ---------------------------------------------------------------------------
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_GRAPH_VERSION=v23.0
FACEBOOK_SCOPES=pages_show_list,pages_read_engagement,pages_manage_posts

# ---------------------------------------------------------------------------
# TikTok (developers.tiktok.com -> your app)
# ---------------------------------------------------------------------------
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# video.publish = Direct Post, video.upload = send to the user's TikTok inbox as a draft.
# Only request scopes your app has been granted in the developer portal.
TIKTOK_SCOPES=user.info.basic,video.publish,video.upload
